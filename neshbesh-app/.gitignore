# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
web-build/
expo-env.d.ts
# dist/ is deployed to Vercel, so we include it in git

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# Firebase credentials for local dev (EXPO_PUBLIC_* are public, but keep the
# local file out of git — values live in Vercel for the deploy). .env.example
# is committed as the template.
.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
