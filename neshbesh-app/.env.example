# ── Firebase (enables cross-device multiplayer) ─────────────────────────────
# Copy this file to `.env` (same folder) and fill in the values from your
# Firebase project:  Firebase console → Project settings (⚙) → "Your apps" →
# Web app → SDK setup and configuration → "Config".
#
# These EXPO_PUBLIC_* vars are inlined into the client bundle by Expo at build
# time. They are NOT secrets — a Firebase web config is meant to be public; the
# database is protected by Realtime Database security rules, not by hiding keys.
#
# For the deployed web app, set the SAME keys in Vercel:
#   Vercel → Project → Settings → Environment Variables (Production + Preview).
#
# IMPORTANT: databaseURL is required (this app uses Realtime Database). If your
# project shows no Realtime Database, create one: console → Build → Realtime
# Database → Create database. The URL looks like:
#   https://<project-id>-default-rtdb.firebaseio.com   (US)
#   https://<project-id>-default-rtdb.<region>.firebasedatabase.app  (EU/Asia)

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
